{
  "folders": [
    {
      "name": "Frontend",
      "path": "frontend"
    },
    {
      "name": "Backend",
      "path": "backend"
    },
    {
      "name": "Design System",
      "path": "design-system"
    },
    {
      "name": "Docs",
      "path": "docs"
    },
    {
      "name": "Packages",
      "path": "packages"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "eslint.workingDirectories": [
      {
        "mode": "auto"
      }
    ],
    "files.exclude": {
      "**/.next": true,
      "**/coverage": true,
      "**/dist": true,
      "**/node_modules": true
    },
    "search.exclude": {
      "**/.next": true,
      "**/coverage": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/package-lock.json": true
    }
  },
  "extensions": {
    "recommendations": [
      "dbaeumer.vscode-eslint",
      "bradlc.vscode-tailwindcss",
      "ms-azuretools.vscode-docker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Michi: DB start",
        "type": "shell",
        "command": "docker compose up -d db",
        "options": {
          "cwd": "${workspaceFolder:Backend}/.."
        },
        "problemMatcher": []
      },
      {
        "label": "Michi: DB migrate",
        "type": "shell",
        "command": "npm run migration:run",
        "options": {
          "cwd": "${workspaceFolder:Backend}"
        },
        "dependsOn": "Michi: DB start",
        "dependsOrder": "sequence",
        "problemMatcher": []
      },
      {
        "label": "Michi: Backend dev",
        "type": "shell",
        "command": "npm run start:dev",
        "options": {
          "cwd": "${workspaceFolder:Backend}"
        },
        "isBackground": true,
        "presentation": {
          "group": "michi-dev",
          "panel": "dedicated"
        },
        "problemMatcher": []
      },
      {
        "label": "Michi: Frontend dev",
        "type": "shell",
        "command": "npm run dev",
        "options": {
          "cwd": "${workspaceFolder:Frontend}"
        },
        "isBackground": true,
        "presentation": {
          "group": "michi-dev",
          "panel": "dedicated"
        },
        "problemMatcher": []
      },
      {
        "label": "Michi: SDK build",
        "type": "shell",
        "command": "npm run build",
        "options": {
          "cwd": "${workspaceFolder:Packages}/log-friends-sdk"
        },
        "problemMatcher": "$tsc"
      },
      {
        "label": "Michi: Verify SDK",
        "type": "shell",
        "command": "npm run lint && npm test && npm run build",
        "options": {
          "cwd": "${workspaceFolder:Packages}/log-friends-sdk"
        },
        "problemMatcher": []
      },
      {
        "label": "Michi: Verify backend",
        "type": "shell",
        "command": "npm run lint && npm test && npm run build",
        "options": {
          "cwd": "${workspaceFolder:Backend}"
        },
        "problemMatcher": []
      },
      {
        "label": "Michi: Verify frontend",
        "type": "shell",
        "command": "npm run lint && npm test && npm run build",
        "options": {
          "cwd": "${workspaceFolder:Frontend}"
        },
        "problemMatcher": []
      },
      {
        "label": "Michi: Verify all",
        "dependsOrder": "sequence",
        "dependsOn": [
          "Michi: Verify SDK",
          "Michi: Verify backend",
          "Michi: Verify frontend"
        ],
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Michi: Backend debug",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "start:debug"
        ],
        "cwd": "${workspaceFolder:Backend}",
        "preLaunchTask": "Michi: DB migrate",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "autoAttachChildProcesses": true,
        "restart": true,
        "sourceMaps": true,
        "outFiles": [
          "${workspaceFolder:Backend}/dist/**/*.js"
        ],
        "skipFiles": [
          "<node_internals>/**"
        ]
      },
      {
        "name": "Michi: Frontend debug",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": [
          "run",
          "dev"
        ],
        "cwd": "${workspaceFolder:Frontend}",
        "preLaunchTask": "Michi: SDK build",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
        "autoAttachChildProcesses": true,
        "skipFiles": [
          "<node_internals>/**"
        ],
        "serverReadyAction": {
          "action": "debugWithChrome",
          "pattern": "- Local:\\s+(https?://\\S+)",
          "uriFormat": "%s",
          "webRoot": "${workspaceFolder:Frontend}",
          "killOnServerStop": true
        }
      },
      {
        "name": "Michi: Frontend browser only",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000",
        "webRoot": "${workspaceFolder:Frontend}",
        "sourceMaps": true
      }
    ],
    "compounds": [
      {
        "name": "Michi: Full stack debug",
        "configurations": [
          "Michi: Backend debug",
          "Michi: Frontend debug"
        ],
        "stopAll": true
      }
    ]
  }
}
